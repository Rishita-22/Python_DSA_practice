--------- Reversing linked list elements -----------


class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class SL:
    head = None  # static-like variable (shared by methods)

    @staticmethod
    def create():
        c = 0
        ch = 'y'
        ptr = None

        while ch == 'y':
            c += 1
            dta = int(input(f"Enter node {c} data: "))
            cur = Node(dta)

            if SL.head is None:
                SL.head = cur
            else:
                ptr.next = cur

            ptr = cur
            ch = input("To create new node press y: ")


    @staticmethod
    def reverse():
        if SL.head is None:  
            print("no element")
            return
        cur = SL.head.next
        
        ptr = SL.head
        SL.head.next = None
        while cur.next is not None:
            temp = cur.next
            cur.next = ptr
            ptr = cur
            cur = temp

        cur.next = ptr 
        SL.head = cur


    @staticmethod
    def disp():
        if SL.head is None:
            print("List is empty")
            return
        print("Elements are:")
        ptr = SL.head
        while ptr is not None:
            print(ptr.data)
            ptr = ptr.next



if __name__ == "__main__":
    SL.create()
    SL.disp()

    SL.reverse()
    SL.disp()
    


